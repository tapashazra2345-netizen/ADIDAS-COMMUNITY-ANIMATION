local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local player = Players.LocalPlayer

-- Animation IDs
local animData = {
    ["idle"]  = 70508706371253,
    ["walk"]  = 106810508343012,
    ["run"]   = 124765145869332,
    ["jump"]  = 129527230938281, -- Adidas Aura Jump (WORKING)
    ["fall"]  = 93993406355955,
    ["climb"] = 123695349157584
}

-- 🛡️ Asset Resolver (Bypass)
local cache = {}
local function resolveIds(input)
    local function resolveSingle(id)
        local numId = tonumber(id)
        if not numId then return nil end
        if cache[numId] then return cache[numId] end
        
        local resolved = nil
        pcall(function()
            local desc = Instance.new("HumanoidDescription")
            desc.WalkAnimation = numId; desc.RunAnimation = numId; desc.JumpAnimation = numId
            desc.FallAnimation = numId; desc.ClimbAnimation = numId; desc.SwimAnimation = numId
            
            local dummy = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
            local animate = dummy:FindFirstChild("Animate")
            
            if animate then
                for _, folder in ipairs(animate:GetChildren()) do
                    if folder:IsA("Folder") and string.lower(folder.Name) ~= "idle" then
                        for _, child in ipairs(folder:GetChildren()) do
                            if child:IsA("Animation") and child.AnimationId ~= "" then
                                resolved = tonumber(child.AnimationId:match("%d+"))
                                if resolved then break end
                            end
                        end
                    end
                    if resolved then break end
                end
            end
            dummy:Destroy()
        end)
        
        if resolved then cache[numId] = resolved return resolved end
        
        pcall(function()
            local objs = game:GetObjects("rbxassetid://" .. tostring(numId))
            if objs and #objs > 0 then
                local function scan(node)
                    if node:IsA("Animation") and node.AnimationId ~= "" then
                        resolved = tonumber(node.AnimationId:match("%d+"))
                        if resolved then return end
                    end
                    for _, child in ipairs(node:GetChildren()) do
                        if resolved then return end
                        scan(child)
                    end
                end
                scan(objs[1])
            end
        end)
        
        if resolved then cache[numId] = resolved end
        return resolved
    end

    if type(input) == "table" then
        local t = {}
        for k, v in pairs(input) do t[k] = resolveSingle(v) end
        return t
    end
    return resolveSingle(input)
end

local function setupCharacter(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    
    local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
    local tracks = {}
    local resolvedIds = resolveIds(animData)
    
    for name, id in pairs(resolvedIds) do
        if id then
            local anim = Instance.new("Animation")
            anim.AnimationId = "rbxassetid://" .. tostring(id)
            local track = animator:LoadAnimation(anim)
            track.Priority = Enum.AnimationPriority.Action4
            if name == "idle" or name == "walk" or name == "run" or name == "climb" then 
                track.Looped = true 
            end
            tracks[name] = track
        end
    end

    local jumpStartTime = 0
    local isJumping = false

    RunService.Heartbeat:Connect(function()
        if not char.Parent or not hum.Parent then return end
        
        local state = hum:GetState()
        local speed = hum.MoveDirection.Magnitude
        local targetTrack

        if state == Enum.HumanoidStateType.Climbing then
            targetTrack = tracks.climb
        elseif state == Enum.HumanoidStateType.Jumping then
            isJumping = true
            jumpStartTime = os.clock()
            targetTrack = tracks.jump
        elseif state == Enum.HumanoidStateType.Freefall then
            if isJumping and (os.clock() - jumpStartTime) < 1.5 then
                targetTrack = tracks.jump 
            else
                targetTrack = tracks.fall
            end
        else
            isJumping = false
            if speed > 0.1 then
                targetTrack = tracks.walk
            else
                targetTrack = tracks.idle
            end
        end

        if targetTrack then
            for _, t in ipairs(animator:GetPlayingAnimationTracks()) do
                if t ~= targetTrack then t:Stop(0) end
            end
            if not targetTrack.IsPlaying then targetTrack:Play(0.1) end
        end
    end)
end

if player.Character then setupCharacter(player.Character) end
player.CharacterAdded:Connect(setupCharacter)

print("🚀 ADIDAS COMMUNITY ANIMATION (Working Jump) Loaded!")